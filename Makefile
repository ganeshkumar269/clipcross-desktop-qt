	@echo "APPL????" > clippycross.app/Contents/PkgInfo
clippycross.app/Contents/Info.plist: 
	@test -d clippycross.app/Contents || mkdir -p clippycross.app/Contents
	@$(DEL_FILE) clippycross.app/Contents/Info.plist
	@plutil -convert xml1 -o - ../../Qt2/6.5.3/macos/mkspecs/macx-clang/Info.plist.app | sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.yourcompany.clippycross,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.yourcompany.clippycross,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},11.0,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,\$${IOS_LAUNCH_SCREEN},LaunchScreen,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,clippycross,g" -e "s,@LIBRARY@,clippycross,g" -e "s,\$${EXECUTABLE_NAME},clippycross,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" >clippycross.app/Contents/Info.plist

